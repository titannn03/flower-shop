# .env.example
# Flower Shop - Environment Variables (Section D.9)

# Supabase Configuration
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose-to-browser

# Cloudinary Configuration
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Public Site Configuration
PUBLIC_SITE_URL=http://localhost:4321

# Admin Portal Credentials (Optional - Defaults provided if unset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FlowerAdmin@2026

