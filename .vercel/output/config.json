{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/products/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/products/([^/]+?)/edit/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/products/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/testimonials/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/videos/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/auth/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/media/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/products/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/products/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/testimonials/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/videos/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cloudinary-sign/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/public/products/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/public/products/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/public/site/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/public/testimonials/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/public/videos/?$",
			"dest": "_render"
		},
		{
			"src": "^/products/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}