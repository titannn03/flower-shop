---
// src/pages/products/index.astro
// Comprehensive Product Catalog Page with Price Filter, Search & Pagination
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import ProductDetailModal from '../../components/products/ProductDetailModal.astro';
import { db } from '../../lib/store/db';

const settings = await db.getSettings();
const allProducts = await db.getPublicProducts();
const occasions = await db.getOccasions();

// All active occasions ensuring 'all' is at front
const allOccasion = occasions.find(o => o.slug === 'all') || { id: 'occ-all', name: 'Tất cả dịp tặng', slug: 'all', sort_order: 0, active: true };
const otherOccasions = occasions.filter(o => o.slug !== 'all');
const displayOccasions = [allOccasion, ...otherOccasions];
---

<PublicLayout 
  settings={settings}
  pageTitle={`Tất Cả Mẫu Hoa Tươi Tuyển Chọn | ${settings.shop_info.name}`}
  pageDescription={`Khám phá bộ sưu tập hơn ${allProducts.length} mẫu hoa tươi nghệ thuật tại ${settings.shop_info.name}. Hoa sinh nhật, khai trương, tốt nghiệp, hoa tình yêu giao nhanh hỏa tốc 2 giờ.`}
>
  <div class="bg-gradient-to-b from-accent/20 via-background to-background min-h-screen py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb & Header -->
      <div class="mb-8">
        <nav class="flex items-center gap-2 text-xs text-textColor-secondary mb-3">
          <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Trang chủ
          </a>
          <span>/</span>
          <span class="text-textColor-primary font-semibold">Tất cả sản phẩm</span>
        </nav>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-primary/10 pb-6">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-accent/60 text-primary text-xs font-bold uppercase tracking-wider mb-2">
              <span>🌸 Bộ Sưu Tập Toàn Diện</span>
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold text-textColor-primary tracking-tight">
              Danh Mục Mẫu Hoa Tươi Nghệ Thuật
            </h1>
            <p class="text-xs sm:text-sm text-textColor-secondary mt-1.5 max-w-2xl">
              Tuyển tập các mẫu hoa tươi nhập mới mỗi ngày, cắm thủ công bởi nghệ nhân và giao nhanh trong 2 giờ.
            </p>
          </div>

          <!-- Total count badge -->
          <div class="flex items-center gap-2 self-start md:self-auto">
            <span class="px-3.5 py-1.5 rounded-full bg-white border border-primary/20 text-xs font-semibold text-primary shadow-sm">
              <strong id="products-count-badge">{allProducts.length}</strong> mẫu hoa sẵn sàng
            </span>
          </div>
        </div>
      </div>

      <!-- Filter & Search Toolbar (Glassmorphism card) -->
      <div class="glass-card rounded-2xl p-4 sm:p-6 mb-8 border border-white/60 shadow-sm space-y-4">
        
        <!-- Row 1: Search Bar & Occasion Dropdown & Sort -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 sm:gap-4">
          
          <!-- Search input (5 cols) -->
          <div class="lg:col-span-5 relative">
            <label for="catalog-search" class="sr-only">Tìm kiếm hoa tươi</label>
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input 
              type="text" 
              id="catalog-search" 
              placeholder="Tìm theo tên hoa, màu sắc, hoa hồng, baby..." 
              class="w-full pl-10 pr-9 py-2.5 rounded-xl border border-neutral-200 bg-white/90 text-sm text-neutral-800 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all shadow-inner"
            />
            <button 
              type="button" 
              id="btn-clear-search" 
              class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-neutral-400 hover:text-neutral-600"
              title="Xóa tìm kiếm"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Occasion Select (3 cols) -->
          <div class="lg:col-span-3">
            <label for="catalog-occasion" class="sr-only">Lọc theo dịp tặng</label>
            <div class="relative">
              <select 
                id="catalog-occasion" 
                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white/90 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all appearance-none pr-8 cursor-pointer shadow-inner"
              >
                {displayOccasions.map((occ) => (
                  <option value={occ.slug}>
                    {occ.slug === 'all' ? 'Tất cả dịp tặng' : `Dịp: ${occ.name}`}
                  </option>
                ))}
              </select>
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-neutral-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Price Range Select (2 cols) -->
          <div class="lg:col-span-2">
            <label for="catalog-price" class="sr-only">Lọc theo khoảng giá</label>
            <div class="relative">
              <select 
                id="catalog-price" 
                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white/90 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all appearance-none pr-8 cursor-pointer shadow-inner"
              >
                <option value="all">Mọi mức giá</option>
                <option value="under-500">Dưới 500.000₫</option>
                <option value="500-1000">500.000₫ – 1.000.000₫</option>
                <option value="1000-2000">1.000.000₫ – 2.000.000₫</option>
                <option value="over-2000">Trên 2.000.000₫</option>
              </select>
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-neutral-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Sorting Select (2 cols) -->
          <div class="lg:col-span-2">
            <label for="catalog-sort" class="sr-only">Sắp xếp</label>
            <div class="relative">
              <select 
                id="catalog-sort" 
                class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white/90 text-sm text-neutral-800 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all appearance-none pr-8 cursor-pointer shadow-inner"
              >
                <option value="featured">Nổi bật nhất</option>
                <option value="price-asc">Giá: Thấp đến cao</option>
                <option value="price-desc">Giá: Cao đến thấp</option>
                <option value="name-asc">Tên: A → Z</option>
              </select>
              <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-neutral-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>

        </div>

        <!-- Row 2: Active Quick Tags & Reset button -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-neutral-100/80 text-xs">
          <div class="flex flex-wrap items-center gap-1.5 text-neutral-500" id="filter-summary-tags">
            <span class="text-neutral-400">Đang hiển thị:</span>
            <span id="active-filter-desc" class="font-semibold text-primary">Tất cả mẫu hoa</span>
          </div>

          <button 
            type="button" 
            id="btn-reset-filters" 
            class="inline-flex items-center gap-1 text-neutral-500 hover:text-rose-600 transition-colors py-1 px-2.5 rounded-lg hover:bg-rose-50"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Đặt lại bộ lọc</span>
          </button>
        </div>

      </div>

      <!-- Product Cards Container (Grid) -->
      <div id="catalog-products-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-7">
        {allProducts.map((product) => {
          const occSlugs = (product.occasions || []).map(o => o.slug).join(' ');
          return (
            <div 
              class="catalog-product-item"
              data-id={product.id}
              data-name={product.name.toLowerCase()}
              data-price={product.price}
              data-featured={product.featured ? '1' : '0'}
              data-occasions={occSlugs}
              data-components={(product.flower_components || '').toLowerCase()}
              data-desc={(product.short_description || '').toLowerCase()}
            >
              <ProductCard product={product} zaloConfig={settings.zalo_config} />
            </div>
          );
        })}
      </div>

      <!-- Empty State (When no products match) -->
      <div id="catalog-empty-state" class="hidden text-center py-20 px-4 bg-white/70 rounded-3xl border border-primary/10 max-w-lg mx-auto shadow-sm my-8">
        <div class="w-16 h-16 mx-auto mb-4 text-primary/40 flex items-center justify-center bg-accent/40 rounded-full">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-serif font-bold text-textColor-primary">
          Không tìm thấy mẫu hoa phù hợp
        </h3>
        <p class="text-xs sm:text-sm text-textColor-secondary mt-1.5 max-w-sm mx-auto">
          Vui lòng thử tìm kiếm với từ khóa khác hoặc điều chỉnh lại khoảng giá và dịp tặng.
        </p>
        <button 
          type="button" 
          id="btn-empty-reset" 
          class="mt-5 btn-pill-primary text-xs py-2.5 px-6 shadow-md"
        >
          Xem lại tất cả mẫu hoa
        </button>
      </div>

      <!-- Pagination Component -->
      <div id="catalog-pagination" class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-primary/10 pt-6">
        <div class="text-xs text-textColor-secondary">
          Hiển thị trang <span id="current-page-num" class="font-bold text-textColor-primary">1</span> trên <span id="total-pages-num" class="font-bold text-textColor-primary">1</span> (Tổng <span id="total-matching-num" class="font-bold text-primary">0</span> mẫu hoa)
        </div>

        <nav class="inline-flex items-center gap-1.5" aria-label="Phân trang sản phẩm" id="pagination-nav">
          <!-- Buttons dynamically rendered in JS -->
        </nav>
      </div>

    </div>
  </div>

  <!-- Quick-View Product Detail Modal -->
  <ProductDetailModal zaloConfig={settings.zalo_config} />
</PublicLayout>

<script>
  // ITEMS PER PAGE CONFIGURATION
  const ITEMS_PER_PAGE = 12;

  // DOM Elements
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
  const clearSearchBtn = document.getElementById('btn-clear-search') as HTMLButtonElement;
  const occasionSelect = document.getElementById('catalog-occasion') as HTMLSelectElement;
  const priceSelect = document.getElementById('catalog-price') as HTMLSelectElement;
  const sortSelect = document.getElementById('catalog-sort') as HTMLSelectElement;
  const resetBtn = document.getElementById('btn-reset-filters') as HTMLButtonElement;
  const emptyResetBtn = document.getElementById('btn-empty-reset') as HTMLButtonElement;

  const productsContainer = document.getElementById('catalog-products-container') as HTMLElement;
  const productItems = Array.from(document.querySelectorAll('.catalog-product-item')) as HTMLElement[];
  const emptyState = document.getElementById('catalog-empty-state') as HTMLElement;
  const paginationWrapper = document.getElementById('catalog-pagination') as HTMLElement;
  const paginationNav = document.getElementById('pagination-nav') as HTMLElement;

  const countBadge = document.getElementById('products-count-badge') as HTMLElement;
  const currentPageNum = document.getElementById('current-page-num') as HTMLElement;
  const totalPagesNum = document.getElementById('total-pages-num') as HTMLElement;
  const totalMatchingNum = document.getElementById('total-matching-num') as HTMLElement;
  const activeFilterDesc = document.getElementById('active-filter-desc') as HTMLElement;

  let currentPage = 1;

  // Normalize string for accent-insensitive search
  function normalizeText(text: string): string {
    return text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .trim();
  }

  // Filter & Sort Logic
  function getFilteredAndSortedItems(): HTMLElement[] {
    const query = normalizeText(searchInput ? searchInput.value : '');
    const selectedOccasion = occasionSelect ? occasionSelect.value : 'all';
    const selectedPrice = priceSelect ? priceSelect.value : 'all';
    const selectedSort = sortSelect ? sortSelect.value : 'featured';

    // 1. Filter
    const filtered = productItems.filter(item => {
      const name = normalizeText(item.getAttribute('data-name') || '');
      const components = normalizeText(item.getAttribute('data-components') || '');
      const desc = normalizeText(item.getAttribute('data-desc') || '');
      const price = parseFloat(item.getAttribute('data-price') || '0');
      const occasions = (item.getAttribute('data-occasions') || '').split(' ');

      // Search match
      if (query && !name.includes(query) && !components.includes(query) && !desc.includes(query)) {
        return false;
      }

      // Occasion match
      if (selectedOccasion !== 'all' && !occasions.includes(selectedOccasion)) {
        return false;
      }

      // Price match
      if (selectedPrice === 'under-500' && price >= 500000) return false;
      if (selectedPrice === '500-1000' && (price < 500000 || price > 1000000)) return false;
      if (selectedPrice === '1000-2000' && (price < 1000000 || price > 2000000)) return false;
      if (selectedPrice === 'over-2000' && price <= 2000000) return false;

      return true;
    });

    // 2. Sort
    filtered.sort((a, b) => {
      const priceA = parseFloat(a.getAttribute('data-price') || '0');
      const priceB = parseFloat(b.getAttribute('data-price') || '0');
      const nameA = a.getAttribute('data-name') || '';
      const nameB = b.getAttribute('data-name') || '';
      const featA = a.getAttribute('data-featured') === '1' ? 1 : 0;
      const featB = b.getAttribute('data-featured') === '1' ? 1 : 0;

      if (selectedSort === 'price-asc') return priceA - priceB;
      if (selectedSort === 'price-desc') return priceB - priceA;
      if (selectedSort === 'name-asc') return nameA.localeCompare(nameB);
      // Default: featured first
      return featB - featA;
    });

    return filtered;
  }

  // Render Page & Pagination Controls
  function render() {
    const matching = getFilteredAndSortedItems();
    const totalMatching = matching.length;
    const totalPages = Math.max(1, Math.ceil(totalMatching / ITEMS_PER_PAGE));

    if (currentPage > totalPages) {
      currentPage = 1;
    }

    // Toggle clear search button
    if (clearSearchBtn) {
      if (searchInput && searchInput.value) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
    }

    // Update count labels
    if (countBadge) countBadge.textContent = totalMatching.toString();
    if (totalMatchingNum) totalMatchingNum.textContent = totalMatching.toString();
    if (currentPageNum) currentPageNum.textContent = currentPage.toString();
    if (totalPagesNum) totalPagesNum.textContent = totalPages.toString();

    // Update filter summary text
    if (activeFilterDesc) {
      const occasionText = occasionSelect && occasionSelect.value !== 'all' ? occasionSelect.options[occasionSelect.selectedIndex].text : '';
      const priceText = priceSelect && priceSelect.value !== 'all' ? priceSelect.options[priceSelect.selectedIndex].text : '';
      const queryText = searchInput && searchInput.value ? `"${searchInput.value}"` : '';

      const tags = [queryText, occasionText, priceText].filter(Boolean);
      activeFilterDesc.textContent = tags.length > 0 ? tags.join(' • ') : 'Tất cả mẫu hoa';
    }

    // Empty state handling
    if (totalMatching === 0) {
      if (productsContainer) productsContainer.classList.add('hidden');
      if (emptyState) emptyState.classList.remove('hidden');
      if (paginationWrapper) paginationWrapper.classList.add('hidden');
      return;
    }

    if (productsContainer) productsContainer.classList.remove('hidden');
    if (emptyState) emptyState.classList.add('hidden');
    if (paginationWrapper) paginationWrapper.classList.remove('hidden');

    // Slice for current page
    const startIdx = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIdx = startIdx + ITEMS_PER_PAGE;
    const pageItems = matching.slice(startIdx, endIdx);

    // Re-order and display
    productItems.forEach(item => {
      item.style.display = 'none';
    });

    pageItems.forEach(item => {
      item.style.display = 'block';
      productsContainer.appendChild(item); // maintains sorted order
    });

    // Render Pagination Controls
    renderPaginationNav(totalPages);

    // Sync URL query params
    syncUrlParams();
  }

  function renderPaginationNav(totalPages: number) {
    if (!paginationNav) return;
    paginationNav.innerHTML = '';

    if (totalPages <= 1) {
      paginationNav.classList.add('hidden');
      return;
    }
    paginationNav.classList.remove('hidden');

    // Previous Button
    const prevBtn = document.createElement('button');
    prevBtn.type = 'button';
    prevBtn.className = `px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all ${
      currentPage > 1
        ? 'border-neutral-300 text-neutral-700 hover:bg-neutral-100 bg-white'
        : 'border-neutral-200 text-neutral-300 cursor-not-allowed bg-neutral-50'
    }`;
    prevBtn.innerHTML = '&larr; Trước';
    prevBtn.disabled = currentPage === 1;
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        render();
        scrollToTop();
      }
    });
    paginationNav.appendChild(prevBtn);

    // Page Number Buttons
    for (let p = 1; p <= totalPages; p++) {
      // Show first, last, current, and surrounding pages
      if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
        const pageBtn = document.createElement('button');
        pageBtn.type = 'button';
        pageBtn.className = `min-w-[36px] h-9 px-2 rounded-xl text-xs font-bold transition-all ${
          p === currentPage
            ? 'bg-primary text-white shadow-md shadow-primary/20 scale-105'
            : 'border border-neutral-200 text-neutral-700 hover:bg-neutral-100 bg-white'
        }`;
        pageBtn.textContent = p.toString();
        pageBtn.addEventListener('click', () => {
          currentPage = p;
          render();
          scrollToTop();
        });
        paginationNav.appendChild(pageBtn);
      } else if (
        (p === currentPage - 2 && p > 1) ||
        (p === currentPage + 2 && p < totalPages)
      ) {
        const dots = document.createElement('span');
        dots.className = 'px-1 text-xs text-neutral-400 font-bold';
        dots.textContent = '...';
        paginationNav.appendChild(dots);
      }
    }

    // Next Button
    const nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.className = `px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all ${
      currentPage < totalPages
        ? 'border-neutral-300 text-neutral-700 hover:bg-neutral-100 bg-white'
        : 'border-neutral-200 text-neutral-300 cursor-not-allowed bg-neutral-50'
    }`;
    nextBtn.innerHTML = 'Sau &rarr;';
    nextBtn.disabled = currentPage === totalPages;
    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        render();
        scrollToTop();
      }
    });
    paginationNav.appendChild(nextBtn);
  }

  function scrollToTop() {
    productsContainer?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function syncUrlParams() {
    const params = new URLSearchParams();
    if (searchInput && searchInput.value.trim()) params.set('q', searchInput.value.trim());
    if (occasionSelect && occasionSelect.value !== 'all') params.set('occasion', occasionSelect.value);
    if (priceSelect && priceSelect.value !== 'all') params.set('price', priceSelect.value);
    if (sortSelect && sortSelect.value !== 'featured') params.set('sort', sortSelect.value);
    if (currentPage > 1) params.set('page', currentPage.toString());

    const newUrl = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }

  function loadFromUrlParams() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('q') && searchInput) searchInput.value = params.get('q') || '';
    if (params.has('occasion') && occasionSelect) occasionSelect.value = params.get('occasion') || 'all';
    if (params.has('price') && priceSelect) priceSelect.value = params.get('price') || 'all';
    if (params.has('sort') && sortSelect) sortSelect.value = params.get('sort') || 'featured';
    if (params.has('page')) currentPage = parseInt(params.get('page') || '1', 10) || 1;
  }

  // Event Listeners
  if (searchInput) {
    let timeout: any;
    searchInput.addEventListener('input', () => {
      clearTimeout(timeout);
      timeout = setTimeout(() => {
        currentPage = 1;
        render();
      }, 250);
    });
  }

  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentPage = 1;
      render();
    });
  }

  if (occasionSelect) {
    occasionSelect.addEventListener('change', () => {
      currentPage = 1;
      render();
    });
  }

  if (priceSelect) {
    priceSelect.addEventListener('change', () => {
      currentPage = 1;
      render();
    });
  }

  if (sortSelect) {
    sortSelect.addEventListener('change', () => {
      currentPage = 1;
      render();
    });
  }

  function resetAll() {
    if (searchInput) searchInput.value = '';
    if (occasionSelect) occasionSelect.value = 'all';
    if (priceSelect) priceSelect.value = 'all';
    if (sortSelect) sortSelect.value = 'featured';
    currentPage = 1;
    render();
  }

  if (resetBtn) resetBtn.addEventListener('click', resetAll);
  if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

  // Initialize on page load
  loadFromUrlParams();
  render();
</script>
