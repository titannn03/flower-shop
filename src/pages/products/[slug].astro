---
// src/pages/products/[slug].astro
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { db } from '../../lib/store/db';
import { formatCurrencyVND } from '../../lib/validators/product';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const product = db.getProductBySlug(slug);

// If product doesn't exist or is not published, redirect to 404
if (!product || product.status !== 'published') {
  return Astro.redirect('/404');
}

const settings = db.getSettings();

// Images & Video handling: PRIORITIZE VIDEO FIRST when viewing product detail if product has video
const images = product.images && product.images.length > 0
  ? [...product.images].sort((a, b) => {
      const aIsVideo = (a.media_type === 'video' || Boolean(a.video_embed_url)) ? 1 : 0;
      const bIsVideo = (b.media_type === 'video' || Boolean(b.video_embed_url)) ? 1 : 0;
      if (aIsVideo !== bIsVideo) return bIsVideo - aIsVideo;
      return (b.is_cover ? 1 : 0) - (a.is_cover ? 1 : 0);
    })
  : [{
      id: 'default-img',
      secure_url: 'https://images.unsplash.com/photo-1561181286-d3fee7d55364?auto=format&fit=crop&w=800&q=80',
      alt_text: product.name,
      is_cover: true,
      sort_order: 0
    }];

const coverImage = images[0];
const initialIsVideo = coverImage.media_type === 'video' || Boolean(coverImage.video_embed_url);

// Pricing & Discount
const hasDiscount = Boolean(product.compare_at_price && product.compare_at_price > product.price);
const discountPercent = hasDiscount 
  ? Math.round(((product.compare_at_price! - product.price) / product.compare_at_price!) * 100)
  : 0;
const savingsAmount = hasDiscount ? product.compare_at_price! - product.price : 0;

// Related products (same occasion or others, excluding current)
const currentOccasionSlugs = (product.occasions || []).map(o => o.slug);
const allPublished = db.getPublicProducts();
const relatedProducts = allPublished
  .filter(p => p.id !== product.id)
  .sort((a, b) => {
    const aMatch = a.occasions?.some(o => currentOccasionSlugs.includes(o.slug)) ? 1 : 0;
    const bMatch = b.occasions?.some(o => currentOccasionSlugs.includes(o.slug)) ? 1 : 0;
    return bMatch - aMatch;
  })
  .slice(0, 3);

// Canonical and Schema.org Product Structured Data
const siteDomain = settings.seo_config.canonical_domain || 'https://flowervibes.vn';
const productUrl = `${siteDomain}/products/${product.slug}`;

const productJsonLd = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": images.map(img => img.secure_url),
  "description": product.short_description || product.name,
  "sku": product.sku || product.id,
  "brand": {
    "@type": "Brand",
    "name": settings.shop_info.name
  },
  "offers": {
    "@type": "Offer",
    "url": productUrl,
    "priceCurrency": "VND",
    "price": product.price,
    "priceValidUntil": "2027-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": settings.shop_info.name
    }
  }
};

const pageTitle = `${product.name} - ${settings.shop_info.name}`;
const pageDesc = product.short_description || `Đặt mua ${product.name} hoa tươi cao cấp giao nhanh 2 giờ tại ${settings.shop_info.name}. Tư vấn và cắm hoa theo yêu cầu qua Zalo.`;
---

<PublicLayout
  settings={settings}
  pageTitle={pageTitle}
  pageDescription={pageDesc}
  ogImage={coverImage.secure_url}
  canonicalUrl={productUrl}
  structuredDataExtra={productJsonLd}
>
  <div class="py-6 sm:py-10 bg-background min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center text-xs sm:text-sm text-textColor-muted mb-6 sm:mb-8 flex-wrap gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
          Trang chủ
        </a>
        <span>/</span>
        <a href="/#san-pham" class="hover:text-primary transition-colors">
          Bộ sưu tập mẫu hoa
        </a>
        {product.occasions && product.occasions.length > 0 && (
          <>
            <span>/</span>
            <a href={`/?occasion=${product.occasions[0].slug}#san-pham`} class="hover:text-primary transition-colors">
              {product.occasions[0].name}
            </a>
          </>
        )}
        <span>/</span>
        <span class="text-textColor-primary font-medium truncate max-w-xs sm:max-w-md">
          {product.name}
        </span>
      </nav>

      <!-- Main Product Details Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left: Image Gallery (5 cols on lg) -->
        <div class="lg:col-span-6 space-y-4">
          <!-- Main Display Image & Video Container -->
          <div class="relative rounded-3xl overflow-hidden glass-card aspect-[4/5] bg-pink-50/50 shadow-lg border border-primary/10">
            <!-- Image display -->
            <img
              id="main-product-image"
              src={coverImage.secure_url}
              alt={coverImage.alt_text || product.name}
              class={`w-full h-full object-cover object-center transition-all duration-300 ${initialIsVideo ? 'hidden' : 'block'}`}
              width="800"
              height="1000"
            />

            <!-- Embedded Video Frame container -->
            <div 
              id="main-video-container" 
              class={`w-full h-full bg-black flex items-center justify-center ${initialIsVideo ? 'block' : 'hidden'}`}
            >
              <iframe
                id="main-video-iframe"
                src={initialIsVideo ? (coverImage.video_embed_url || '') : ''}
                class="w-full h-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>

            <!-- Badges -->
            <div class="absolute top-4 left-4 flex flex-col gap-2 items-start pointer-events-none">
              {product.featured && (
                <span class="bg-primary text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full shadow-md">
                  ★ Mẫu hoa nổi bật
                </span>
              )}
              {hasDiscount && (
                <span class="bg-rose-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-md">
                  Tiết kiệm {discountPercent}%
                </span>
              )}
            </div>

            <!-- Fast Delivery Tag -->
            <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-bold text-textColor-primary flex items-center gap-1.5 shadow-md pointer-events-none">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Giao hỏa tốc 60 - 120 phút
            </div>
          </div>

          <!-- Thumbnails Row (if more than 1 image or video) -->
          {images.length > 1 && (
            <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none" id="product-thumbnails">
              {images.map((img, index) => {
                const isVideo = img.media_type === 'video' || Boolean(img.video_embed_url);
                return (
                  <button
                    type="button"
                    class={`thumbnail-btn relative flex-shrink-0 w-20 h-24 rounded-2xl overflow-hidden border-2 transition-all duration-200 ${
                      index === 0 ? 'border-primary ring-2 ring-primary/30 shadow-md' : 'border-transparent opacity-70 hover:opacity-100'
                    }`}
                    data-is-video={isVideo ? 'true' : 'false'}
                    data-img-url={img.secure_url}
                    data-embed-url={img.video_embed_url || ''}
                    data-img-alt={img.alt_text || product.name}
                    aria-label={`Xem ${isVideo ? 'video' : 'ảnh'} ${index + 1}`}
                  >
                    <img
                      src={img.secure_url}
                      alt={img.alt_text || `${product.name} ${index + 1}`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      width="120"
                      height="150"
                    />
                    {isVideo && (
                      <div class="absolute inset-0 bg-black/40 flex items-center justify-center pointer-events-none">
                        <div class="w-7 h-7 rounded-full bg-rose-600 text-white flex items-center justify-center text-xs shadow-md">
                          ▶
                        </div>
                      </div>
                    )}
                  </button>
                );
              })}
            </div>
          )}

          <!-- Trust Guarantees Mini Strip -->
          <div class="grid grid-cols-2 gap-3 pt-3">
            <div class="p-3 rounded-2xl bg-white/70 border border-primary/10 flex items-center gap-2.5 shadow-sm">
              <div class="w-8 h-8 rounded-full bg-pink-100 text-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <span class="text-xs text-textColor-primary font-medium">Chụp ảnh hoa trước khi giao</span>
            </div>

            <div class="p-3 rounded-2xl bg-white/70 border border-primary/10 flex items-center gap-2.5 shadow-sm">
              <div class="w-8 h-8 rounded-full bg-pink-100 text-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span class="text-xs text-textColor-primary font-medium">Hoa tươi mới nhập trong ngày</span>
            </div>
          </div>
        </div>

        <!-- Right: Information & Ordering Zone (6 cols on lg) -->
        <div class="lg:col-span-6 space-y-6">
          
          <!-- Occasions Tags -->
          {product.occasions && product.occasions.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {product.occasions.map(occ => (
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary bg-accent/40 px-3 py-1 rounded-full">
                  <span>🌸</span>
                  {occ.name}
                </span>
              ))}
            </div>
          )}

          <!-- Product Title & SKU -->
          <div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-textColor-primary leading-tight">
              {product.name}
            </h1>
            {product.sku && (
              <p class="text-xs text-textColor-muted mt-1.5 font-mono">
                Mã sản phẩm: <span class="font-semibold text-textColor-secondary">{product.sku}</span>
              </p>
            )}
          </div>

          <!-- Price Display Section -->
          <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-pink-50/80 to-white/90 border border-primary/15 shadow-sm">
            <div class="flex items-baseline gap-3 flex-wrap">
              <span class="text-2xl sm:text-3xl lg:text-4xl font-serif font-bold text-primary">
                {formatCurrencyVND(product.price)}
              </span>
              {hasDiscount && (
                <span class="text-base sm:text-lg text-textColor-muted line-through font-medium">
                  {formatCurrencyVND(product.compare_at_price!)}
                </span>
              )}
            </div>

            {hasDiscount && (
              <p class="mt-2 text-xs font-medium text-emerald-700 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Bạn tiết kiệm được <strong>{formatCurrencyVND(savingsAmount)}</strong> khi đặt hôm nay!
              </p>
            )}
          </div>

          <!-- Short Description -->
          {product.short_description && (
            <p class="text-sm sm:text-base text-textColor-secondary leading-relaxed">
              {product.short_description}
            </p>
          )}

          <!-- Flower Composition (Thành phần hoa) -->
          {product.flower_components && (
            <div class="p-4 rounded-2xl bg-white/80 border border-primary/10 shadow-sm space-y-1.5">
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-primary">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                Thành phần nguyên liệu bó hoa
              </div>
              <p class="text-sm text-textColor-primary font-medium leading-relaxed">
                {product.flower_components}
              </p>
            </div>
          )}

          <!-- Long Description / Story -->
          {product.description && (
            <div class="space-y-2 pt-2 border-t border-primary/10">
              <h3 class="text-sm font-bold uppercase tracking-wider text-textColor-primary">
                Ý nghĩa & Phong cách thiết kế
              </h3>
              <div 
                class="prose prose-sm text-textColor-secondary leading-relaxed max-w-none prose-p:my-1.5 prose-strong:text-textColor-primary"
                set:html={product.description}
              />
            </div>
          )}

          <!-- Inclusive Gifts & Services -->
          <div class="p-4 rounded-2xl bg-accent/25 border border-primary/10 space-y-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-textColor-primary flex items-center gap-1.5">
              <span>🎁</span> Quà tặng & Dịch vụ đi kèm
            </h4>
            <ul class="text-xs sm:text-sm text-textColor-secondary space-y-1.5">
              <li class="flex items-center gap-2">
                <span class="text-primary font-bold">✔</span>
                Tặng kèm thiệp chúc mừng hoặc banner thiết kế in màu cao cấp
              </li>
              <li class="flex items-center gap-2">
                <span class="text-primary font-bold">✔</span>
                Tặng gói dưỡng hoa Chrysal giúp hoa tươi lâu trên 7 ngày
              </li>
              <li class="flex items-center gap-2">
                <span class="text-primary font-bold">✔</span>
                Chụp ảnh thực tế thành phẩm gửi Zalo cho bạn duyệt trước khi giao
              </li>
            </ul>
          </div>

          <!-- PRIMARY CONVERSION CTA ZONE (Zalo First) -->
          <div class="space-y-3 pt-4">
            <button
              type="button"
              id="detail-zalo-cta-btn"
              class="w-full btn-pill-primary py-4 px-6 text-base sm:text-lg font-bold shadow-xl justify-center text-center flex items-center gap-2 group transform active:scale-95 transition-all"
              data-product-name={product.name}
              data-product-sku={product.sku || ''}
              data-product-id={product.id}
              data-product-slug={product.slug}
              data-zalo-url={settings.zalo_config.url}
              aria-label={`Đặt mua ${product.name} qua Zalo`}
            >
              <svg class="w-6 h-6 fill-current transform group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.03 2 11c0 2.87 1.5 5.43 3.84 7.07-.17 1.05-.62 2.65-1.57 3.86 0 0 2.45-.3 4.25-1.54.48.07.97.11 1.48.11 5.52 0 10-4.03 10-9S17.52 2 12 2z"/>
              </svg>
              <span>Nhắn Zalo Đặt Mẫu Hoa Này Ngay</span>
            </button>

            <!-- Secondary Contact Link -->
            <div class="flex items-center justify-between text-xs text-textColor-muted px-2 flex-wrap gap-2">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                </svg>
                Tư vấn nhanh 24/7 qua Zalo
              </span>
              <a 
                href={`tel:${settings.shop_info.hotline.replace(/\D/g, '')}`} 
                class="hover:text-primary transition-colors font-medium flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                </svg>
                Cần gấp? Gọi hotline: <span class="font-bold underline">{settings.shop_info.hotline}</span>
              </a>
            </div>
          </div>

          <!-- Flower Care Tips Accordion / Note -->
          <div class="mt-6 p-4 rounded-2xl bg-white/70 border border-primary/10">
            <h4 class="text-xs font-bold uppercase tracking-wider text-textColor-primary flex items-center gap-1.5 mb-2">
              <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Mẹo giữ hoa tươi lâu tại nhà
            </h4>
            <p class="text-xs text-textColor-secondary leading-relaxed">
              Cắt vát gốc cành hoa 45 độ bằng dao sắc trước khi cắm. Thay nước sạch mỗi ngày một lần và cho thêm nửa gói dưỡng hoa. Đặt hoa ở nơi mát mẻ, tránh luồng gió phả trực tiếp từ máy lạnh hoặc ánh nắng gắt.
            </p>
          </div>

        </div>

      </div>

      <!-- Related Products Section -->
      {relatedProducts && relatedProducts.length > 0 && (
        <section class="mt-16 sm:mt-24 pt-12 border-t border-primary/15">
          <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
            <div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/50 text-primary text-xs font-bold uppercase tracking-wider mb-2">
                <span>💐 Mẫu Hoa Tương Tự</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-serif font-bold text-textColor-primary">
                Có thể bạn cũng sẽ thích
              </h2>
            </div>
            <a 
              href="/#san-pham" 
              class="btn-pill-secondary text-xs sm:text-sm py-2 px-4 flex items-center gap-1"
            >
              <span>Xem tất cả mẫu hoa</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {relatedProducts.map(relProd => (
              <ProductCard product={relProd} zaloConfig={settings.zalo_config} />
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</PublicLayout>

<script>
  import { trackEvent } from '../../lib/analytics/tracker';

  // 1. Thumbnail Click Switcher (Supports both Images and Videos)
  const mainImg = document.getElementById('main-product-image') as HTMLImageElement | null;
  const videoContainer = document.getElementById('main-video-container') as HTMLElement | null;
  const videoIframe = document.getElementById('main-video-iframe') as HTMLIFrameElement | null;
  const thumbnailBtns = document.querySelectorAll<HTMLButtonElement>('.thumbnail-btn');

  thumbnailBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const isVideo = btn.getAttribute('data-is-video') === 'true';
      const targetUrl = btn.getAttribute('data-img-url');
      const targetEmbed = btn.getAttribute('data-embed-url');
      const targetAlt = btn.getAttribute('data-img-alt');

      if (isVideo && targetEmbed) {
        if (mainImg) mainImg.classList.add('hidden');
        if (videoContainer && videoIframe) {
          videoContainer.classList.remove('hidden');
          videoIframe.src = targetEmbed;
        }
      } else {
        if (videoContainer && videoIframe) {
          videoContainer.classList.add('hidden');
          videoIframe.src = '';
        }
        if (mainImg && targetUrl) {
          mainImg.classList.remove('hidden');
          mainImg.style.opacity = '0.5';
          setTimeout(() => {
            mainImg.src = targetUrl;
            if (targetAlt) mainImg.alt = targetAlt;
            mainImg.style.opacity = '1';
          }, 150);
        }
      }

      // Update active thumbnail borders
      thumbnailBtns.forEach(b => {
        b.classList.remove('border-primary', 'ring-2', 'ring-primary/30', 'shadow-md', 'opacity-100');
        b.classList.add('border-transparent', 'opacity-70');
      });
      btn.classList.add('border-primary', 'ring-2', 'ring-primary/30', 'shadow-md', 'opacity-100');
      btn.classList.remove('border-transparent', 'opacity-70');
    });
  });

  // 2. Conversion CTA Handler
  const detailZaloBtn = document.getElementById('detail-zalo-cta-btn') as HTMLButtonElement | null;

  if (detailZaloBtn) {
    detailZaloBtn.addEventListener('click', async () => {
      const productName = detailZaloBtn.getAttribute('data-product-name') || '';
      const productSku = detailZaloBtn.getAttribute('data-product-sku') || '';
      const productId = detailZaloBtn.getAttribute('data-product-id') || '';
      const productSlug = detailZaloBtn.getAttribute('data-product-slug') || '';
      const zaloUrl = detailZaloBtn.getAttribute('data-zalo-url') || 'https://zalo.me';

      const skuText = productSku ? ` (Mã: ${productSku})` : '';
      const copyMessage = `Tư vấn giúp mình mẫu hoa: ${productName}${skuText}`;

      // Step 1: Copy to clipboard
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(copyMessage);
        }
      } catch (err) {
        console.warn('Clipboard copy error:', err);
      }

      // Step 2: Show toast feedback
      if ((window as any).showToast) {
        (window as any).showToast('Đã copy tên mẫu hoa! Hãy dán vào ô chat Zalo để shop tư vấn ngay nhé.', 4500);
      }

      // Step 3: Analytics tracking
      trackEvent('click_zalo', {
        cta_location: 'product_detail',
        product_id: productId || productSlug,
        page_path: window.location.pathname
      });

      // Step 4: Open Zalo
      setTimeout(() => {
        window.open(zaloUrl, '_blank', 'noopener,noreferrer');
      }, 700);
    });
  }
</script>
