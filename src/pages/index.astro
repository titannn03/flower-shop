---
// src/pages/index.astro
// Main Landing Page for Flower Shop
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../components/landing/Hero.astro';
import ProductGrid from '../components/products/ProductGrid.astro';
import Commitments from '../components/landing/Commitments.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import { db } from '../lib/store/db';

// SSR fetch latest settings & published content
const settings = await db.getSettings();
const products = await db.getPublicProducts();
const occasions = await db.getOccasions();
const commitments = await db.getCommitments();
const testimonials = await db.getPublicTestimonials();
---

<PublicLayout settings={settings}>
  <!-- Hero Section -->
  <Hero heroConfig={settings.hero_config} zaloConfig={settings.zalo_config} />

  <!-- Featured Products Section with Occasion Filter -->
  <ProductGrid 
    products={products} 
    occasions={occasions} 
    zaloConfig={settings.zalo_config} 
  />

  <!-- 4 Quality Commitments Section -->
  {commitments.length > 0 && <Commitments commitments={commitments} />}

  <!-- Customer Testimonials & Reviews Section -->
  {testimonials.length > 0 && <Testimonials testimonials={testimonials} />}
</PublicLayout>
