---
// src/pages/admin/settings/index.astro
// Admin Settings Page (Zalo, Shop Info, Hero, SEO, Commitments)
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { db } from '../../../lib/store/db';

const settings = db.getSettings();
const commitments = db.getAllAdminCommitments();
---

<AdminLayout title="Cấu hình Hệ thống & Zalo" subtitle="Tùy chỉnh thông tin liên hệ, liên kết Zalo chuyển đổi, banner và SEO">
  
  <form id="settings-form" class="space-y-8 max-w-4xl">

    <!-- 1. Global Zalo Conversion Settings (BR-02 & Section 10.1) -->
    <div class="bg-white rounded-2xl border-2 border-primary/20 p-6 sm:p-8 shadow-sm space-y-5">
      <div class="flex items-center gap-3 border-b border-primary/10 pb-4">
        <div class="w-10 h-10 rounded-xl bg-[#0068FF] text-white flex items-center justify-center font-bold">
          Z
        </div>
        <div>
          <h2 class="text-base font-serif font-bold text-neutral-900">
            1. Cấu hình Kênh Chuyển Đổi Zalo Toàn Cục
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Zalo URL -->
        <div class="sm:col-span-2">
          <label for="zalo-url" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Đường dẫn Zalo (zalo_url) <span class="text-rose-500">* Bắt buộc HTTPS</span>
          </label>
          <input 
            type="url" 
            id="zalo-url" 
            name="zalo_url" 
            required 
            value={settings.zalo_config.url}
            class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary focus:outline-none text-sm font-mono"
            placeholder="https://zalo.me/0901234567"
          />
        </div>

        <!-- Hotline for Zalo -->
        <div>
          <label for="zalo-hotline" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Số điện thoại Hotline / Zalo
          </label>
          <input 
            type="text" 
            id="zalo-hotline" 
            name="zalo_hotline" 
            value={settings.zalo_config.hotline}
            class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary focus:outline-none text-sm font-bold text-neutral-800"
            placeholder="0901.234.567"
          />
        </div>

        <!-- Zalo OA ID -->
        <div>
          <label for="zalo-oa" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Mã định danh Zalo OA (Official Account ID)
          </label>
          <input 
            type="text" 
            id="zalo-oa" 
            name="zalo_oa_id" 
            value={settings.zalo_config.zalo_oa_id || ''}
            class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary focus:outline-none text-sm font-mono"
            placeholder="1234567890123"
          />
        </div>
      </div>
    </div>

    <!-- 2. Store Info Settings -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm space-y-5">
      <h2 class="text-base font-serif font-bold text-neutral-900 border-b border-neutral-100 pb-3">
        2. Thông tin Tiệm hoa & Liên hệ
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="shop-name" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Tên Tiệm hoa
          </label>
          <input type="text" id="shop-name" name="shop_name" value={settings.shop_info.name} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm font-bold" />
        </div>

        <div>
          <label for="shop-slogan" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Slogan thương hiệu
          </label>
          <input type="text" id="shop-slogan" name="shop_slogan" value={settings.shop_info.slogan} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" />
        </div>

        <div class="sm:col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-2">
            Địa chỉ cửa hàng
          </label>
          <div class="space-y-3">
            {['Chi nhánh 1', 'Chi nhánh 2', 'Chi nhánh 3'].map((label, index) => {
              const value = settings.shop_info.addresses?.[index]?.address ?? (index === 0 ? settings.shop_info.address : '');
              return (
                <div class="grid grid-cols-[110px_1fr] gap-2 items-center">
                  <span class="text-xs font-semibold text-neutral-700">{label}</span>
                  <input
                    type="text"
                    class="shop-branch-address w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm"
                    value={value}
                    data-index={index}
                    data-label={label}
                  />
                </div>
              );
            })}
          </div>
        </div>

        <div>
          <label for="shop-email" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Email liên hệ
          </label>
          <input type="email" id="shop-email" name="shop_email" value={settings.shop_info.email} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" />
        </div>

        <div>
          <label for="shop-hours" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Giờ mở cửa
          </label>
          <input type="text" id="shop-hours" name="shop_hours" value={settings.shop_info.opening_hours} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" />
        </div>
      </div>
    </div>

    <!-- 3. Hero Copy Settings -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm space-y-5">
      <h2 class="text-base font-serif font-bold text-neutral-900 border-b border-neutral-100 pb-3">
        3. Nội dung Banner Hero trang chủ
      </h2>

      <div class="space-y-4">
        <div>
          <label for="hero-eyebrow" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Dòng thẻ nhỏ (Eyebrow Tag)
          </label>
          <input type="text" id="hero-eyebrow" name="hero_eyebrow" value={settings.hero_config.eyebrow} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm font-semibold text-primary" />
        </div>

        <div>
          <label for="hero-headline" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Tiêu đề chính (Headline H1)
          </label>
          <input type="text" id="hero-headline" name="hero_headline" value={settings.hero_config.headline} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm font-serif font-bold text-lg" />
        </div>

        <div>
          <label for="hero-subheadline" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Đoạn mô tả phụ (Subheadline)
          </label>
          <textarea id="hero-subheadline" name="hero_subheadline" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm">{settings.hero_config.subheadline}</textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="hero-cta" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
              Chữ nút CTA chính (Zalo)
            </label>
            <input type="text" id="hero-cta" name="hero_cta" value={settings.hero_config.cta_label} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" />
          </div>
          <div>
            <label for="hero-cta-secondary" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
              Chữ nút CTA phụ (Cuộn xem)
            </label>
            <input type="text" id="hero-cta-secondary" name="hero_cta_secondary" value={settings.hero_config.cta_secondary_label} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" />
          </div>
        </div>
      </div>
    </div>

    <!-- 4. SEO & Social Sharing -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm space-y-5">
      <h2 class="text-base font-serif font-bold text-neutral-900 border-b border-neutral-100 pb-3">
        4. Cấu hình SEO & Chia sẻ Mạng Xã Hội
      </h2>

      <div class="space-y-4">
        <div>
          <label for="seo-title" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Meta Title (Khuyến nghị 50–60 ký tự)
          </label>
          <input type="text" id="seo-title" name="seo_title" value={settings.seo_config.meta_title} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" />
        </div>

        <div>
          <label for="seo-desc" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
            Meta Description (Khuyến nghị 140–160 ký tự)
          </label>
          <textarea id="seo-desc" name="seo_desc" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm">{settings.seo_config.meta_description}</textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="seo-domain" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
              Canonical Domain
            </label>
            <input type="url" id="seo-domain" name="seo_domain" value={settings.seo_config.canonical_domain || ''} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" placeholder="https://flowervibes.vn" />
          </div>

          <div>
            <label for="seo-og-image" class="block text-xs font-bold uppercase tracking-wider text-neutral-700 mb-1.5">
              OG Image URL
            </label>
            <input type="url" id="seo-og-image" name="seo_og_image" value={settings.seo_config.og_image || ''} class="w-full px-4 py-2.5 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm" placeholder="https://images.unsplash.com/..." />
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Commitments Management -->
    <div class="bg-white rounded-2xl border border-neutral-200 p-6 sm:p-8 shadow-sm space-y-6">
      <div class="border-b border-neutral-100 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-base font-serif font-bold text-neutral-900">
            5. Quản lý Cam Kết Vàng Về Dịch Vụ
          </h2>
          <p class="text-xs text-neutral-500 mt-0.5">
            Tùy chỉnh tiêu đề, mô tả, biểu tượng và trạng thái hiển thị của các cam kết dịch vụ
          </p>
        </div>
      </div>

      <div class="space-y-4" id="commitments-container">
        {commitments.map((com, idx) => (
          <div class="commitment-item p-4 sm:p-5 rounded-2xl border border-neutral-200 bg-neutral-50/70 space-y-3.5" data-id={com.id}>
            <div class="flex items-center justify-between pb-2 border-b border-neutral-200/60">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-primary/10 text-primary text-xs font-bold">
                Cam kết #{idx + 1}
              </span>
              <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-neutral-700">
                <input 
                  type="checkbox" 
                  class="commitment-toggle w-4 h-4 rounded text-primary focus:ring-primary" 
                  data-id={com.id} 
                  checked={com.active} 
                />
                <span>Hiển thị trên website</span>
              </label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-neutral-700 mb-1">
                  Tiêu đề cam kết <span class="text-rose-500">*</span>
                </label>
                <input 
                  type="text" 
                  class="commitment-title w-full px-3.5 py-2 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm bg-white" 
                  value={com.title} 
                  required
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-neutral-700 mb-1">
                  Biểu tượng (Icon)
                </label>
                <select class="commitment-icon w-full px-3.5 py-2 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm bg-white">
                  <option value="sparkles" selected={com.icon_key === 'sparkles'}>✨ Tuyển chọn (sparkles)</option>
                  <option value="clock" selected={com.icon_key === 'clock'}>⏰ Giao nhanh 2h (clock)</option>
                  <option value="gift" selected={com.icon_key === 'gift'}>🎁 Thiệp & Quà (gift)</option>
                  <option value="shield-check" selected={com.icon_key === 'shield-check'}>🛡️ Đổi trả & Hoàn tiền (shield-check)</option>
                  <option value="truck" selected={com.icon_key === 'truck'}>🚚 Vận chuyển an toàn (truck)</option>
                  <option value="heart" selected={com.icon_key === 'heart'}>💖 Tận tâm thiết kế (heart)</option>
                  <option value="award" selected={com.icon_key === 'award'}>🏆 Chất lượng uy tín (award)</option>
                  <option value="phone" selected={com.icon_key === 'phone'}>📞 Hỗ trợ 24/7 (phone)</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
              <div class="sm:col-span-3">
                <label class="block text-xs font-semibold text-neutral-700 mb-1">
                  Mô tả chi tiết cam kết <span class="text-rose-500">*</span>
                </label>
                <textarea 
                  class="commitment-desc w-full px-3.5 py-2 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm bg-white" 
                  rows="2" 
                  required
                >{com.description}</textarea>
              </div>

              <div>
                <label class="block text-xs font-semibold text-neutral-700 mb-1">
                  Thứ tự hiển thị
                </label>
                <input 
                  type="number" 
                  class="commitment-order w-full px-3.5 py-2 rounded-xl border border-neutral-300 focus:ring-2 focus:ring-primary text-sm bg-white" 
                  value={com.sort_order ?? (idx + 1)} 
                  min="1" 
                  max="99" 
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Save Action Bar -->
    <div class="flex items-center justify-end gap-4 pt-4">
      <button 
        type="submit" 
        id="save-settings-btn" 
        class="btn-pill-primary text-sm sm:text-base py-3 px-8 shadow-lg"
      >
        Lưu Toàn Bộ Cấu Hình
      </button>
    </div>

  </form>
</AdminLayout>

<script>
  const form = document.getElementById('settings-form') as HTMLFormElement | null;
  const saveBtn = document.getElementById('save-settings-btn') as HTMLButtonElement | null;

  const getFieldValue = (id: string, fallback = '') => {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    return el ? el.value.trim() : fallback;
  };

  if (form && saveBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      saveBtn.textContent = 'Đang lưu cấu hình...';

      // Gather commitments with full content
      const commitmentElements = document.querySelectorAll('.commitment-item');
      const commitments: any[] = [];
      commitmentElements.forEach(item => {
        const id = item.getAttribute('data-id');
        const titleInput = item.querySelector('.commitment-title') as HTMLInputElement | null;
        const descInput = item.querySelector('.commitment-desc') as HTMLTextAreaElement | null;
        const iconSelect = item.querySelector('.commitment-icon') as HTMLSelectElement | null;
        const orderInput = item.querySelector('.commitment-order') as HTMLInputElement | null;
        const toggleInput = item.querySelector('.commitment-toggle') as HTMLInputElement | null;

        commitments.push({
          id,
          title: titleInput ? titleInput.value.trim() : '',
          description: descInput ? descInput.value.trim() : '',
          icon_key: iconSelect ? iconSelect.value : 'sparkles',
          sort_order: orderInput ? parseInt(orderInput.value, 10) || 1 : 1,
          active: toggleInput ? toggleInput.checked : true
        });
      });

      const branchInputs = Array.from(document.querySelectorAll('.shop-branch-address')) as HTMLInputElement[];
      const addresses = branchInputs
        .map((input, index) => ({
          id: `branch-${index + 1}`,
          label: input.dataset.label || `Chi nhánh ${index + 1}`,
          address: input.value.trim()
        }))
        .filter((item) => item.address.length > 0);

      const payload = {
        zalo_config: {
          url: getFieldValue('zalo-url'),
          hotline: getFieldValue('zalo-hotline'),
          zalo_oa_id: getFieldValue('zalo-oa')
        },
        shop_info: {
          name: getFieldValue('shop-name'),
          slogan: getFieldValue('shop-slogan'),
          address: addresses[0]?.address || '',
          addresses,
          email: getFieldValue('shop-email'),
          opening_hours: getFieldValue('shop-hours')
        },
        hero_config: {
          eyebrow: getFieldValue('hero-eyebrow'),
          headline: getFieldValue('hero-headline'),
          subheadline: getFieldValue('hero-subheadline'),
          cta_label: getFieldValue('hero-cta'),
          cta_secondary_label: getFieldValue('hero-cta-secondary')
        },
        seo_config: {
          meta_title: getFieldValue('seo-title'),
          meta_description: getFieldValue('seo-desc'),
          canonical_domain: getFieldValue('seo-domain'),
          og_image: getFieldValue('seo-og-image')
        },
        commitments
      };

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success) {
          alert('Cập nhật cấu hình website thành công! Toàn bộ liên kết Zalo đã được đồng bộ.');
          window.location.reload();
        } else {
          alert(data.error?.message || 'Lỗi cập nhật cấu hình');
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Lưu Toàn Bộ Cấu Hình';
      }
    });
  }
</script>
