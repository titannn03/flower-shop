---
// src/components/admin/AdminNav.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/admin' } = Astro.props;

const navItems = [
  { href: '/admin', label: 'Tổng quan', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/admin/products', label: 'Quản lý Sản phẩm', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { href: '/admin/occasions', label: 'Phân loại sản phẩm', icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z' },
  { href: '/admin/videos', label: 'Quản lý Video', icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z' },
  { href: '/admin/testimonials', label: 'Đánh giá khách hàng', icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z' },
  { href: '/admin/settings', label: 'Cấu hình Cửa hàng & Zalo', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' }
];
---

<aside class="w-64 bg-neutral-900 text-neutral-300 min-h-screen flex flex-col justify-between p-4 flex-shrink-0 border-r border-neutral-800 hidden md:flex">
  <div>
    <!-- Brand -->
    <a href="/admin" class="group px-3 py-4 flex items-center gap-3 border-b border-neutral-800 transition-colors hover:bg-neutral-800/40">
      <!-- Vòng tròn nền sáng nổi bật bọc logo -->
      <div class="w-10 h-10 rounded-full bg-stone-100 flex items-center justify-center shadow-lg border border-white/20 transform group-hover:scale-110 transition-transform p-1">
        <img src="/logo.png" alt="Tiệm Hoa An Khánh" class="w-full h-full object-contain" />
      </div>

      <div>
        <span class="block text-base font-serif font-bold text-white leading-tight">Tiệm Hoa<br>An Khánh</span>
      </div>
    </a>


    <!-- Navigation links -->
    <nav class="mt-6 space-y-1">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors ${
              isActive
                ? 'bg-primary text-white shadow-sm'
                : 'hover:bg-neutral-800 hover:text-white text-neutral-400'
            }`}
          >
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Bottom actions -->
  <div class="pt-4 border-t border-neutral-800 space-y-2">
    <a
      href="/"
      target="_blank"
      class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs text-neutral-400 hover:text-white hover:bg-neutral-800 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
      <span>Xem trang công khai</span>
    </a>
    <button
      id="admin-logout-btn"
      type="button"
      class="w-full flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs text-rose-400 hover:bg-rose-500/10 transition-colors text-left"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span>Đăng xuất</span>
    </button>
  </div>
</aside>

<script>
  const logoutBtn = document.getElementById('admin-logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/admin/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'logout' })
        });
      } finally {
        window.location.href = '/admin/login';
      }
    });
  }
</script>
