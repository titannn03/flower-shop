---
// src/components/products/OccasionFilter.astro
import type { Occasion } from '../../types';

interface Props {
  occasions: Occasion[];
  activeSlug?: string;
}

const { occasions, activeSlug = 'all' } = Astro.props;
---

<div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-4 no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
  {occasions.map((occ) => {
    const isActive = occ.slug === activeSlug;
    return (
      <button
        type="button"
        data-filter-slug={occ.slug}
        class={`filter-btn whitespace-nowrap px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 min-h-[44px] flex items-center justify-center ${
          isActive
            ? 'bg-primary text-white shadow-md shadow-primary/20 scale-105'
            : 'bg-white/80 hover:bg-white text-textColor-secondary hover:text-primary border border-primary/10'
        }`}
      >
        {occ.name}
      </button>
    );
  })}
</div>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
