---
// src/components/landing/Commitments.astro
import type { Commitment } from '../../types';

interface Props {
  commitments: Commitment[];
}

const { commitments } = Astro.props;

// Icon map helper
function renderIcon(iconKey: string) {
  switch (iconKey) {
    case 'sparkles':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`;
    case 'clock':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`;
    case 'gift':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm0 0v4m0 0H7m5 0h5m-9 9h8a2 2 0 002-2v-5H6v5a2 2 0 002 2z" />`;
    case 'shield-check':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`;
    case 'truck':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8h4.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-4 0h-2" />`;
    case 'heart':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`;
    case 'award':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />`;
    case 'phone':
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />`;
    default:
      return `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 13l4 4L19 7" />`;
  }
}
---

{commitments && commitments.length > 0 && (
  <section id="cam-ket" class="py-16 md:py-24 bg-background relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-accent/60 text-primary text-xs font-bold uppercase tracking-wider">
          <span>🛡 An Tâm Đặt Hoa</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-textColor-primary text-center">
          {commitments.length === 4 ? 'Cam Kết Vàng Về Chất Lượng' : `${commitments.length} Cam Kết Vàng Về Chất Lượng`}
        </h2>
        <p class="text-sm sm:text-base text-textColor-secondary font-normal text-center">
          Mỗi đơn hàng gửi trao là sự tín nhiệm quý giá. Chúng tôi cam kết mang lại trải nghiệm hoa tươi trọn vẹn nhất.
        </p>
      </div>

      <!-- Commitments Centered Grid / Flex Layout -->
      <div class="flex flex-wrap justify-center items-stretch gap-6">
        {commitments.map((com) => (
          <div class="glass-card rounded-3xl p-6 sm:p-7 flex flex-col items-center justify-start text-center group w-full sm:w-[calc(50%-16px)] lg:w-[calc(25%-18px)] min-w-[240px] max-w-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
            <!-- Icon Container (Centered) -->
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-accent/80 to-white text-primary flex items-center justify-center mb-5 shadow-sm group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-300 mx-auto">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <Fragment set:html={renderIcon(com.icon_key)} />
              </svg>
            </div>

            <!-- Title (Centered) -->
            <h3 class="font-serif font-bold text-lg text-textColor-primary leading-snug mb-2 text-center w-full">
              {com.title}
            </h3>

            <!-- Description (Centered) -->
            <p class="text-xs sm:text-sm text-textColor-secondary leading-relaxed font-normal text-center w-full mt-1">
              {com.description}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>
)}
