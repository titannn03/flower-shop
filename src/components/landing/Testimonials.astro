---
// src/components/landing/Testimonials.astro
import type { Testimonial } from '../../types';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

{testimonials && testimonials.length > 0 && (
  <section id="danh-gia" class="py-16 md:py-24 bg-background-alt relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-accent/60 text-primary text-xs font-bold uppercase tracking-wider">
          <span>❤️ Trải Nghiệm Khách Hàng</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-textColor-primary">
          Niềm Vui Của Người Nhận Hoa
        </h2>
        <p class="text-sm sm:text-base text-textColor-secondary font-normal">
          Hơn 99% khách hàng hài lòng và quay lại đặt hoa thường xuyên cùng chúng tôi.
        </p>
      </div>

      <!-- Testimonials Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {testimonials.map((test) => (
          <div 
            class="testimonial-card glass-card rounded-3xl p-6 sm:p-7 flex flex-col justify-between"
            data-testimonial-id={test.id}
          >
            <div>
              <!-- 5-Star Rating -->
              <div class="flex items-center gap-1 text-amber-400 mb-4" aria-label={`Đánh giá ${test.rating} trên 5 sao`}>
                {Array.from({ length: test.rating }).map(() => (
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>

              <!-- Quote Content -->
              <blockquote class="text-sm sm:text-base text-textColor-primary leading-relaxed font-normal italic">
                “{test.content}”
              </blockquote>
            </div>

            <!-- Customer Avatar & Name -->
            <div class="mt-6 pt-5 border-t border-primary/10 flex items-center gap-3">
              {test.image_url ? (
                <img 
                  src={test.image_url} 
                  alt={test.customer_name} 
                  class="w-11 h-11 rounded-full object-cover ring-2 ring-accent"
                  loading="lazy"
                  width="44"
                  height="44"
                />
              ) : (
                <div class="w-11 h-11 rounded-full bg-accent text-primary font-bold flex items-center justify-center text-sm">
                  {test.customer_name.charAt(0)}
                </div>
              )}
              <div>
                <p class="font-serif font-bold text-sm sm:text-base text-textColor-primary">
                  {test.customer_name}
                </p>
                <p class="text-xs text-textColor-muted">Khách hàng xác thực</p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
)}
