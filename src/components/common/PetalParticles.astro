---
// src/components/common/PetalParticles.astro
// Decorative floating flower petals and light particles (Section 5)
---

<div class="pointer-events-none absolute inset-0 overflow-hidden z-10" aria-hidden="true">
  <!-- Petal 1 (Top Left) -->
  <div class="absolute top-[12%] left-[8%] w-10 h-10 text-primary/30 animate-floating">
    <svg viewBox="0 0 40 40" fill="currentColor">
      <path d="M20 0 C30 10 35 25 20 40 C5 25 10 10 20 0 Z" />
    </svg>
  </div>

  <!-- Petal 2 (Top Right) -->
  <div class="absolute top-[18%] right-[10%] w-8 h-8 text-accent/80 animate-floating-delay">
    <svg viewBox="0 0 40 40" fill="currentColor">
      <path d="M20 0 C35 15 30 30 20 40 C10 30 5 15 20 0 Z" />
    </svg>
  </div>

  <!-- Petal 3 (Mid Left) -->
  <div class="absolute top-[45%] left-[5%] w-7 h-7 text-primary/20 animate-floating-delay">
    <svg viewBox="0 0 40 40" fill="currentColor">
      <path d="M20 0 C32 12 32 28 20 40 C8 28 8 12 20 0 Z" />
    </svg>
  </div>

  <!-- Leaf (Mid Right) -->
  <div class="absolute top-[55%] right-[7%] w-9 h-9 text-emerald-700/20 animate-floating">
    <svg viewBox="0 0 40 40" fill="currentColor">
      <path d="M10 35 C10 15 25 5 35 10 C35 30 20 40 10 35 Z" />
    </svg>
  </div>

  <!-- Soft glow orb -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 rounded-full bg-accent/40 blur-3xl -z-10"></div>
</div>
