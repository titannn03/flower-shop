---
// src/components/media/VideoSection.astro
import type { Video } from '../../types';

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;
---

{videos && videos.length > 0 && (
  <section id="video" class="py-16 md:py-24 bg-background-alt relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-accent/60 text-primary text-xs font-bold uppercase tracking-wider">
          <span>🎬 Nghệ Thuật & Câu Chuyện</span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-textColor-primary">
          Khoảnh Khắc Hoa Trao Tay
        </h2>
        <p class="text-sm sm:text-base text-textColor-secondary font-normal">
          Chiêm ngưỡng quá trình nghệ nhân tạo tác từng bó hoa tươi và những câu chuyện đong đầy tình cảm.
        </p>
      </div>

      <!-- Videos Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
        {videos.map((vid) => {
          const isTikTok = vid.provider === 'tiktok';
          const defaultThumbnail = vid.thumbnail_url || 'https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=800&q=80';
          
          return (
            <div class="glass-card rounded-3xl overflow-hidden p-4 sm:p-5 flex flex-col justify-between h-full">
              <!-- Video Facade Container (FE-07 & FE-11) -->
              <div 
                class="video-facade-container relative rounded-2xl overflow-hidden bg-neutral-900 group cursor-pointer"
                style={{ aspectRatio: isTikTok ? '9/16' : '16/9', maxHeight: isTikTok ? '560px' : 'auto' }}
                data-provider={vid.provider}
                data-embed-url={vid.embed_url || ''}
                data-source-url={vid.source_url}
                data-title={vid.title || 'Video Flower Shop'}
              >
                <!-- Thumbnail Poster -->
                <img 
                  src={defaultThumbnail} 
                  alt={vid.title || 'Video cắm hoa'} 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width={isTikTok ? 360 : 640}
                  height={isTikTok ? 640 : 360}
                />

                <!-- Dark gradient overlay -->
                <div class="absolute inset-0 bg-black/35 group-hover:bg-black/25 transition-colors"></div>

                <!-- Play Button Icon Overlay -->
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-primary/90 text-white flex items-center justify-center shadow-xl group-hover:scale-110 group-hover:bg-primary transition-all duration-300">
                    <svg class="w-8 h-8 sm:w-10 sm:h-10 fill-current translate-x-0.5" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>

                <!-- Badge Provider -->
                <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md px-3 py-1 rounded-full text-white text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5">
                  {isTikTok ? '🎵 TikTok' : '▶ YouTube'}
                </div>

                <!-- Fallback Button in case embed fails or user prefers original link (FE-11) -->
                <div class="absolute bottom-4 right-4 z-20">
                  <a 
                    href={vid.source_url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="bg-white/90 hover:bg-white text-neutral-900 px-3 py-1.5 rounded-full text-xs font-medium shadow-md transition-colors flex items-center gap-1 fallback-source-btn"
                  >
                    <span>Mở nguồn</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Video Meta -->
              <div class="mt-4 px-1">
                <h3 class="font-serif font-bold text-lg sm:text-xl text-textColor-primary leading-snug">
                  {vid.title}
                </h3>
                {vid.caption && (
                  <p class="mt-1.5 text-xs sm:text-sm text-textColor-secondary leading-relaxed">
                    {vid.caption}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>
)}

<script>
  import { trackEvent } from '../../lib/analytics/tracker';

  // Facade click listener: Replaces thumbnail with actual iframe upon user click
  document.querySelectorAll('.video-facade-container').forEach(facade => {
    facade.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.fallback-source-btn')) {
        return;
      }
      const container = e.currentTarget as HTMLElement;
      const embedUrl = container.getAttribute('data-embed-url');
      const provider = (container.getAttribute('data-provider') || 'youtube') as 'youtube' | 'tiktok';
      const title = container.getAttribute('data-title') || 'Video';
      const sourceUrl = container.getAttribute('data-source-url') || '';

      if (!embedUrl) {
        window.open(sourceUrl, '_blank', 'noopener,noreferrer');
        return;
      }

      // Track play_video event
      trackEvent('play_video', {
        provider,
        video_id: embedUrl
      });

      // Render responsive iframe with autoplay
      const iframeSrc = embedUrl.includes('?') ? `${embedUrl}&autoplay=1` : `${embedUrl}?autoplay=1`;
      
      container.innerHTML = `
        <iframe 
          src="${iframeSrc}" 
          title="${title}" 
          class="w-full h-full border-0 rounded-2xl" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen 
          loading="lazy"
        ></iframe>
      `;
    });
  });
</script>
